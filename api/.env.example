# --- Database: SQLite locally, AlloyDB (PostgreSQL) in Google Cloud ---
DATABASE_URL=sqlite:///./cashpilot.db
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ALLOYDB_PRIVATE_IP:5432/cashpilot

# --- Auth: dev (demo user header) or firebase (verifies Firebase ID tokens) ---
AUTH_MODE=dev
# FIREBASE_PROJECT_ID=your-firebase-project

# --- Google AI (leave empty to run fully offline with the local engines) ---
# GEMINI_API_KEY=your-key-from-google-ai-studio
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTO_SEED=true
