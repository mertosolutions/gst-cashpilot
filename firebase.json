{
  "hosting": {
    "public": "web/out",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "trailingSlash": true,
    "headers": [
      { "source": "/_next/static/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
    ]
  },
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "GST CashPilot",
        "supportEmail": "your-email@example.com",
        "authorizedRedirectUris": [
          "https://gstcashcopilot.firebaseapp.com/__/auth/handler",
          "http://localhost:3000"
        ]
      }
    }
  }
}
